# Travelar server configuration — placeholders only. Copy to .env.local, never commit it.
#
# Development runs on PostgreSQL 18. Use a restricted application role, not the
# administrator role your IDE client uses, and a separate role for migrations.

APP_ENV=development

# Canonical public origin for CSRF same-origin checks (no trailing slash).
# Required in staging/production when the Node process Host is not the site host.
# APP_PUBLIC_ORIGIN=https://travelar.co.tz

# Application runtime. Server-only: must never be exposed as a VITE_* variable.
DATABASE_URL=postgresql://travelar_app:REPLACE_ME@localhost:5432/travelar_dev

# Schema migrations (separate role where practical).
MIGRATION_DATABASE_URL=postgresql://travelar_migrator:REPLACE_ME@localhost:5432/travelar_dev

# Automated tests. Must point at a disposable database, never at development.
TEST_DATABASE_URL=postgresql://travelar_test:REPLACE_ME@localhost:5432/travelar_test
DB_TARGET=development

# TLS. Verification is on by default; trust the issuer rather than disabling it.
# DATABASE_SSL=true
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL_REJECT_UNAUTHORIZED=false   # development-only, deliberate, never production

DATABASE_POOL_MAX=10

# Signs the ticket QR. Minimum 16 characters; the verification endpoint fails closed
# without it rather than accepting tokens it cannot check.
TICKET_VERIFY_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Shared secret a payment provider signs its callback with (HMAC-SHA256 over the raw
# body). Minimum 32 characters; shorter values are treated as unset and the callback
# endpoint refuses every request. Generate with: openssl rand -hex 32
PAYMENT_CALLBACK_SECRET=

# ClickPesa. There is no sandbox — every request moves real money, so the adapter
# refuses to run unless CLICKPESA_LIVE=true is set deliberately.
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_LIVE=false
# Signs and verifies ClickPesa collection checksums. Minimum 16 characters;
# shorter values are treated as unset and the webhook refuses every request.
CLICKPESA_CHECKSUM_SECRET=

# Signs the booking-access JWT. Minimum 32 characters; unset means createBooking
# fails closed rather than issuing tokens it cannot verify later.
# Generate with: openssl rand -hex 32
BOOKING_ACCESS_SECRET=

# Extra browser origins allowed to call booking/payment mutations (comma-separated).
# Same-origin requests are always allowed; leave empty unless a separate front end exists.
# ALLOWED_ORIGINS=https://staging.travelar.example

# Guards the maintenance endpoint a scheduler calls (expiry sweep). Minimum 32
# characters; unset means the endpoint refuses every request.
MAINTENANCE_SECRET=

# Travelport TripServices (flights and stays).
#
# Endpoints are derived from TRAVELPORT_ENVIRONMENT: PREPROD uses https://auth.pp.travelport.net
# and https://api.pp.travelport.net; PRODUCTION uses https://auth.travelport.net and
# https://api.travelport.net. Override the *_BASE_URL values only if provisioning says so.
#
# Disabled by default. When disabled, flights and stays answer "not available" — they never
# fall back to sample data.
TRAVELPORT_ENABLED=false
TRAVELPORT_ENVIRONMENT=PREPROD

TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=
# Not every provisioning model uses both; some grants need only the client pair.
TRAVELPORT_USERNAME=
TRAVELPORT_PASSWORD=

# At least one of these must be set before any API call is made. Travelport resolves content
# entitlement, forms of payment and ticketing authority from the branch, not from the token.
TRAVELPORT_PCC=
TRAVELPORT_ACCESS_GROUP=
TRAVELPORT_GDS=

# GDS, NDC, or both. Content source changes pricing and servicing rules, not just data.
# Pre-production welcome mail for this branch: Region EMEA:UK, currency GBP.
TRAVELPORT_CONTENT_SOURCES=GDS,NDC
TRAVELPORT_REGION=EMEA:UK
TRAVELPORT_POINT_OF_SALE=GB
TRAVELPORT_CURRENCY=GBP

# Entitlement lists from Travelport. Not sent on search unless TRAVELPORT_CARRIER_PREFERENCE
# is Preferred or Permitted. 1G is a host code, not an airline; do not Permitted-filter it
# without Travelport confirming the shop accepts it as a carrier.
# TRAVELPORT_GDS_CARRIERS=AA AC AS BA BG DL EB GQ IZ KE KF KG LF LH OD PC PD PW QH RC TB TC TJ UA UO UU VJ ZH A9 B6 E9 F9 Q4 2D 2M 3E 4B 4N 4P 5Z 7H 8P 9N 9V 1G
# TRAVELPORT_NDC_CARRIERS=AA UA QF SQ
# TRAVELPORT_CARRIER_PREFERENCE=

# Optional overrides.
# TRAVELPORT_AUTH_BASE_URL=https://auth.pp.travelport.net
# TRAVELPORT_FLIGHTS_BASE_URL=https://api.pp.travelport.net/11/air
# TRAVELPORT_STAYS_V11_BASE_URL=https://api.pp.travelport.net/11/hotel
# SearchComplete v12 is a gated capability: leave unset until Travelport confirms it.
# TRAVELPORT_STAYS_V12_BASE_URL=https://api.pp.travelport.net/12/hotel
# TRAVELPORT_PROBE_STAY_CITY=Dar es Salaam
# TRAVELPORT_PROBE_STAY_COUNTRY=TZ
# TRAVELPORT_PROBE_STAY_AIRPORT=DAR
#
# Sabre and Amadeus are registered adapter siblings. They have no credentials here
# because search/booking stay capability-blocked until contract, entitlement and
# PROVEN registry rows exist. Do not add live keys to enable them.

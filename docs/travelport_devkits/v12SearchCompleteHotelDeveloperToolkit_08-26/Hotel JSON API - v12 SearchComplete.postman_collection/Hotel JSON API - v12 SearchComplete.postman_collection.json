      "name": "Bearer auth",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonResponse = JSON.parse(responseBody);\r",
              "\r",
              "pm.test(\"Check Existence of Bearer token\", function () {\r",
              "    var token = jsonResponse.access_token;\r",
              "\r",
              "    pm.expect(token).to.exist;    \r",
              "});\r",
              "\r",
              "var token = jsonResponse.access_token;\r",
              "\r",
              "pm.collectionVariables.set(\"bearerToken\", token);\r",
              "\r",
              "// Function to add days to the current date and format it\r",
              "function addDaysAndGetFormattedDate(daysToAdd) {\r",
              "    const today = new Date();\r",
              "    today.setDate(today.getDate() + daysToAdd);\r",
              "\r",
              "    const year = today.getFullYear();\r",
              "    const month = String(today.getMonth() + 1).padStart(2, '0'); // Months are zero-indexed\r",
              "    const day = String(today.getDate()).padStart(2, '0');\r",
              "\r",
              "    return `${year}-${month}-${day}`;\r",
              "}\r",
              "\r",
              "// Example usage: calculate a date 30 days in the future\r",
              "const arrival_date = addDaysAndGetFormattedDate(30);\r",
              "const departure_date = addDaysAndGetFormattedDate(31);\r",
              "\r",
              "// Set the calculated date as a variable in Postman\r",
              "pm.collectionVariables.set(\"checkIndate\", arrival_date);\r",
              "pm.collectionVariables.set(\"checkOutdate\", departure_date);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
